# POC: HTTPS on bare IP (self-signed via tls internal).
# When you have a real domain, replace :443 with {$PUBLIC_HOST} and remove tls internal.

:443 {
  tls internal
  encode gzip

  handle /hooks/* {
    reverse_proxy orchestrator:8080 {
      header_up Host {host}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-For {remote_host}
      header_up X-Real-IP {remote_host}
    }
  }

  handle_path /loop/* {
    reverse_proxy orchestrator:8080 {
      header_up Host {host}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-For {remote_host}
      header_up X-Real-IP {remote_host}
    }
  }

  handle {
    reverse_proxy agent-canvas:8000 {
      header_up Host {host}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-For {remote_host}
      header_up X-Real-IP {remote_host}
      transport http {
        read_timeout 3600s
        write_timeout 3600s
      }
    }
  }
}

:80 {
  redir https://{host}{uri} permanent
}
