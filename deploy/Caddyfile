{$LOOP_DOMAIN} {
  encode gzip

  @api path /api/* /hooks/* /health
  handle @api {
    reverse_proxy orchestrator:8080 {
      header_up Host {host}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-For {remote_host}
      header_up X-Real-IP {remote_host}
    }
  }

  handle {
    reverse_proxy openhands:3000 {
      header_up Host {host}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-For {remote_host}
      header_up X-Real-IP {remote_host}
    }
  }
}
