# PUBLIC_IP env var must be set (public IPv4). See scripts/public-ip.sh

{
  default_sni {$PUBLIC_IP}
}

https://{$PUBLIC_IP} {
  tls internal
  encode gzip

  handle /hooks/* {
    reverse_proxy orchestrator:8080 {
      header_up Host {host}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-For {remote_host}
      header_up X-Real-IP {remote_host}
    }
  }

  handle /orchestrator/* {
    reverse_proxy orchestrator:8080 {
      header_up Host {host}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-For {remote_host}
      header_up X-Real-IP {remote_host}
    }
  }

  handle {
    reverse_proxy agent-canvas:8000 {
      header_up Host {host}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-For {remote_host}
      header_up X-Real-IP {remote_host}
      transport http {
        read_timeout 3600s
        write_timeout 3600s
      }
    }
  }
}

http://{$PUBLIC_IP} {
  redir https://{host}{uri} permanent
}
