{
  email {$ACME_EMAIL}
}

{$LOOP_DOMAIN} {
  encode gzip

  # Orchestrator (Jira webhooks + loop API) — must NOT steal Agent Canvas /api/*
  handle /hooks/* {
    reverse_proxy orchestrator:8080 {
      header_up Host {host}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-For {remote_host}
      header_up X-Real-IP {remote_host}
    }
  }

  handle_path /loop/* {
    reverse_proxy orchestrator:8080 {
      header_up Host {host}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-For {remote_host}
      header_up X-Real-IP {remote_host}
    }
  }

  # Agent Canvas (UI + backend on :8000) — includes WebSocket/SSE for live events
  handle {
    reverse_proxy agent-canvas:8000 {
      header_up Host {host}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-For {remote_host}
      header_up X-Real-IP {remote_host}
      transport http {
        read_timeout 3600s
        write_timeout 3600s
      }
    }
  }
}
