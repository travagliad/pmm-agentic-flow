[Unit]
Description=ngrok tunnel to local nginx ingress
After=network-online.target nginx.service
Requires=nginx.service

[Service]
Type=simple
Environment=HOME=/root
EnvironmentFile=/etc/pmm-agentic-flow/env
ExecStart=/usr/bin/ngrok http 8787 --url=${NGROK_DOMAIN}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
