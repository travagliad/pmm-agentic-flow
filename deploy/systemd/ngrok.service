[Unit]
Description=ngrok tunnel to local nginx ingress
After=network-online.target nginx.service agent-canvas.service orchestrator.service
Requires=nginx.service
Wants=agent-canvas.service orchestrator.service

[Service]
Type=simple
Environment=HOME=/root
ExecStart=/opt/pmm-agentic-flow/ngrok-tunnel.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
