[Unit]
Description=OpenHands Agent Canvas on control plane
Documentation=https://docs.openhands.dev/openhands/usage/agent-canvas/backend-setup/vm
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentcanvas
Group=agentcanvas
EnvironmentFile=/etc/pmm-agentic-flow/env
Environment=PORT=8000
Environment=FILE_STORE=local
Environment=LOCAL_STORAGE_PATH=/home/agentcanvas/.openhands/storage
Environment=AUTOMATION_WORKSPACE_BASE=/projects
Environment=AUTOMATION_DB_URL=sqlite+aiosqlite:////home/agentcanvas/.openhands/automation/automations.db
ExecStart=/opt/pmm-agentic-flow/agent-canvas-start.sh
Restart=on-failure
RestartSec=15
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
