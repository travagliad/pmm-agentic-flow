# Copy to terraform.tfvars and fill secrets. Never commit terraform.tfvars.

linode_token            = "YOUR_LINODE_TOKEN"
root_password           = "GENERATE_A_STRONG_PASSWORD"
worker_root_password    = "GENERATE_A_DIFFERENT_PASSWORD_FOR_QA_WORKERS"
bootstrap_repo_url      = "https://github.com/travagliad/pmm-agentic-flow.git"

# Canvas UI login + orchestrator→Canvas API (same value, two env names on VM)
agent_canvas_api_key    = "canvas-api-key-change-me"
agent_canvas_secret_key = "canvas-secret-change-me"
agent_canvas_version    = "latest"

# /orchestrator/* (x-api-key) + Jira webhook /hooks/jira (x-webhook-secret)
api_secret              = "loop-api-secret-change-me"

github_token            = "ghp_..."
github_copilot_token    = "gho_..."   # optional; defaults to github_token on VM
cursor_api_key          = ""          # optional; Cursor ACP

region                  = "eu-central"
instance_type           = "g6-standard-4"   # control plane only — workers: config/stack.yaml
admin_cidrs             = ["YOUR.PUBLIC.IP/32"]

jira_base_url           = "https://your-org.atlassian.net"
jira_email              = "you@example.com"
jira_api_token          = ""

ngrok_authtoken         = ""
ngrok_domain            = ""
expose_ports_directly   = false
data_volume_size        = 50
