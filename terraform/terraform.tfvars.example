# Copy to terraform.tfvars and fill secrets. Never commit terraform.tfvars.
#
# terraform apply provisions everything — no manual Linode steps.

linode_token            = "YOUR_LINODE_TOKEN"
root_password           = "GENERATE_A_STRONG_PASSWORD"
worker_root_password    = "GENERATE_A_DIFFERENT_PASSWORD_FOR_QA_WORKERS"
bootstrap_repo_url      = "https://github.com/travagliad/pmm-agentic-flow.git"
github_token            = "ghp_..."
github_copilot_token    = "gho_..."
agent_canvas_api_key    = "canvas-api-key-change-me"
agent_canvas_secret_key = "canvas-secret-change-me"
agent_canvas_version    = "latest"
orchestrator_api_key    = "orch-change-me"
region                  = "eu-central"
instance_type           = "g6-standard-4"
worker_linode_type      = "g6-standard-8"
worker_linode_region    = "eu-central"
admin_cidrs             = ["YOUR.PUBLIC.IP/32"]
admin_cidrs_v6          = []
jira_base_url           = "https://your-org.atlassian.net"
jira_email              = "you@example.com"
jira_api_token          = ""
jira_webhook_secret     = "webhook-secret-change-me"
cursor_api_key          = ""

# Stable public URL (recommended). Free static domain from ngrok dashboard.
ngrok_authtoken         = ""
ngrok_domain            = "" # e.g. https://pmm-agentic.ngrok-free.app

# Dev only: open :8000/:8080 on Linode firewall. Ignored when ngrok_domain is set.
expose_ports_directly   = false

# Chats + orchestrator state survive Linode replace when volume is reattached.
data_volume_size        = 50
