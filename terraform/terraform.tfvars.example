# Linode sizes must match config/stack.yaml → infrastructure.linode
linode_token            = "YOUR_LINODE_TOKEN"
root_password           = "GENERATE_A_STRONG_PASSWORD"
worker_root_password    = "GENERATE_A_DIFFERENT_PASSWORD_FOR_QA_WORKERS"
bootstrap_repo_url      = "https://github.com/travagliad/pmm-agentic-flow.git"
github_token            = "ghp_..."
agent_canvas_api_key    = "canvas-api-key-change-me"
agent_canvas_secret_key = "canvas-secret-change-me"
orchestrator_api_key    = "orch-change-me"
region                  = "eu-central"
instance_type           = "g6-standard-4"
worker_linode_type      = "g6-standard-8"
worker_linode_region    = "eu-central"
admin_cidrs             = ["0.0.0.0/0"]
admin_cidrs_v6          = ["::/0"]
jira_base_url           = "https://your-org.atlassian.net"
jira_email              = "you@example.com"
jira_api_token          = ""
jira_webhook_secret     = "webhook-secret-change-me"
