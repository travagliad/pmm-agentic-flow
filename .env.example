# ── Linode (Terraform) ─────────────────────────────────────────────
LINODE_TOKEN=
LINODE_REGION=eu-central
LINODE_INSTANCE_TYPE=g6-dedicated-8
LINODE_LABEL=pmm-agentic-flow
LINODE_ROOT_PASSWORD=

# ── Domain / TLS (Caddy) ───────────────────────────────────────────
# Leave empty in terraform — auto: pmmagents.<ip-dashes>.sslip.io
LOOP_DOMAIN=pmmagents.139-162-150-187.sslip.io
ACME_EMAIL=you@example.com

# ── GitHub ─────────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_COPILOT_TOKEN=

# ── LiteLLM (optional — configure Agent Canvas Settings > LLM to use) ──
LITELLM_MASTER_KEY=change-me-to-a-long-random-string
LITELLM_MODEL=github/gpt-4.1
COPILOT_EDITOR_VERSION=vscode/1.96.0
COPILOT_INTEGRATION_ID=vscode-chat

# ── Agent Canvas (https://docs.openhands.dev/openhands/usage/agent-canvas/setup) ──
AGENT_CANVAS_VERSION=latest
AGENT_CANVAS_API_KEY=change-me-agent-canvas-api-key
AGENT_CANVAS_SECRET_KEY=change-me-agent-canvas-secret
AGENT_CANVAS_UID=1000
AGENT_CANVAS_PUBLIC_URL=https://loop.example.com

# Legacy aliases (orchestrator still reads these as fallbacks)
OPENHANDS_API_KEY=change-me-agent-canvas-api-key
OPENHANDS_PUBLIC_URL=https://loop.example.com

# ── Orchestrator ───────────────────────────────────────────────────
ORCHESTRATOR_PORT=8080
ORCHESTRATOR_API_KEY=change-me-orchestrator-key
SANDBOX_TTL_HOURS=72
MAX_AGENT_RETRIES=2
MAX_BUILD_RETRIES=5

# ── Jira (optional — logs only if unset) ───────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=
