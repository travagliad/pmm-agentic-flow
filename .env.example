# ── Control plane (Linode) ─────────────────────────────────────────
# Public URL set at bootstrap: https://<linode-ip>/
AGENT_CANVAS_VERSION=latest
AGENT_CANVAS_API_KEY=change-me-canvas-api-key
AGENT_CANVAS_SECRET_KEY=change-me-canvas-secret
AGENT_CANVAS_PUBLIC_URL=https://127.0.0.1
AGENT_CANVAS_UID=1000

ORCHESTRATOR_API_KEY=change-me-orchestrator-key

GITHUB_TOKEN=

# QA workers (8GB, ephemeral — created on In QA)
LINODE_TOKEN=
WORKER_LINODE_REGION=eu-central
WORKER_LINODE_TYPE=g6-standard-8
WORKER_ROOT_PASSWORD=change-me-worker-root-password

# Jira
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=
